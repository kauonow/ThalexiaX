<link rel="stylesheet" href="https://unpkg.com" />
<script src="https://unpkg.com"></script>
<script src="https://cloudflare.com"></script>

<script>
function renderDigitalGardenLeaflets() {
  // Match both <pre class="language-leaflet"> and <code class="language-leaflet">
  const candidates = document.querySelectorAll("pre.language-leaflet, pre > code.language-leaflet");

  candidates.forEach((el, index) => {
    const preElement = el.tagName === "PRE" ? el : el.parentElement;
    if (!preElement || preElement.dataset.leafletProcessed) return;
    preElement.dataset.leafletProcessed = "true";

    let config;
    try {
      // Wrap [[wikilinks]] in quotes so js-yaml reads them as strings instead of nested arrays
      const sanitizedYaml = preElement.textContent.replace(/(\[\[.*?\]\])/g, '"$1"');
      config = jsyaml.load(sanitizedYaml);
    } catch (e) {
      console.error("Failed to parse Leaflet YAML:", e);
      return;
    }

    if (!config || typeof config !== "object") return;

    // Create map container
    const mapDiv = document.createElement("div");
    mapDiv.id = config.id || `dg-leaflet-map-${index}`;
    mapDiv.style.height = config.height || "650px";
    mapDiv.style.width = config.width || "100%";
    mapDiv.style.zIndex = "1";
    mapDiv.style.borderRadius = "8px";
    preElement.replaceWith(mapDiv);

    const isCustomImage = Boolean(config.image);
    const lat = Number(config.lat) || 0;
    const long = Number(config.long) || 0;
    const zoom = config.defaultZoom !== undefined ? Number(config.defaultZoom) : 0;

    const mapOptions = {
      minZoom: config.minZoom !== undefined ? Number(config.minZoom) : -2,
      maxZoom: config.maxZoom !== undefined ? Number(config.maxZoom) : 4,
      zoomDelta: config.zoomDelta !== undefined ? Number(config.zoomDelta) : 0.5,
      zoomSnap: config.zoomDelta !== undefined ? Number(config.zoomDelta) : 0.5
    };

    if (isCustomImage) {
      mapOptions.crs = L.CRS.Simple;
    }

    const map = L.map(mapDiv.id, mapOptions).setView([lat, long], zoom);

    if (isCustomImage) {
      const imgName = String(config.image).replace(/[\[\]]/g, "").trim();
      const imgUrl = `/img/user/${encodeURIComponent(imgName)}`;
      const bounds = Array.isArray(config.bounds) ? config.bounds : [[0, 0], [1000, 1000]];

      L.imageOverlay(imgUrl, bounds).addTo(map);
      if (config.lat === undefined || config.long === undefined) {
        map.fitBounds(bounds);
      }
    } else {
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: config.maxZoom || 19,
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(map);
    }

    // Render markers
    if (config.marker) {
      const markers = Array.isArray(config.marker) ? config.marker : [config.marker];
      markers.forEach((m) => {
        const parts = String(m).split(",").map((s) => s.trim());
        if (parts.length >= 3) {
          const mLat = parseFloat(parts[1]);
          const mLng = parseFloat(parts[2]);
          const rawLink = parts[3] ? parts[3].replace(/[\[\]]/g, "").trim() : "";

          if (!isNaN(mLat) && !isNaN(mLng)) {
            const markerObj = L.marker([mLat, mLng]).addTo(map);
            if (rawLink) {
              // Convert note name into a Digital Garden slug link
              const slug = rawLink.toLowerCase().replace(/[^a-z0-9\u00C0-\u017F]+/g, "-").replace(/^-|-$/g, "");
              markerObj.bindPopup(`<a href="/notes/${slug}/"><b>${rawLink}</b></a>`);
            }
          }
        }
      });
    }
  });
}

document.addEventListener("DOMContentLoaded", renderDigitalGardenLeaflets);
window.addEventListener("load", renderDigitalGardenLeaflets);
</script>
